" ~/.ideavimrc -- IntelliJ IDEA (Java / Spring Boot), laid out like LazyVim on Omarchy.
"
" Keys follow LazyVim's defaults (https://www.lazyvim.org/keymaps) plus the
" lang.java, lang.sql and ai extras, and the personal tweaks from
" ~/.config/nvim/lua/config/keymaps.lua. LazyVim keys with no IntelliJ
" equivalent are left unmapped rather than faked.
"
" Marketplace plugins this file uses (Settings > Plugins > Marketplace):
"   IdeaVim                  Vim emulation
"   Which-Key                leader popups (or Which Key Lazy -- same
"                            `set which-key` name, install one, not both)
"   vim-flash                flash.nvim: s, S, f/F/t/T/;/,
"   Vim AnyObject            tree-sitter text objects (mini.ai letters)
"   Vim Peekaboo             register popup on " and insert <C-r>
"   Lazygit (by ckob)        <leader>gg / <leader>gG
"   Claude Code [Beta]       <leader>a (claudecode.nvim extra)
"   AceJump                  needed by VimEverywhere (Ctrl+Shift+\ hints)
" Everything else used here is built into IdeaVim.
" Reload after editing:  :source ~/.ideavimrc
" Find an action's ID:   :set ideatrackactionids, then trigger the action.
"
" Mapping rules used throughout: never put a trailing comment on a map line (it
" becomes part of the mapping), and use x-mode maps, not v-mode, so nothing
" fires in Select mode, where IntelliJ puts you while renaming.

let mapleader = " "
let maplocalleader = "\\"


" ============================================================================
" Options (LazyVim config/options.lua + Neovim defaults)
" ============================================================================

set number
set relativenumber
set cursorline
set scrolloff=4
set sidescrolloff=8
set nowrap
set nostartofline
set ignorecase
set smartcase
set incsearch
set hlsearch
set showmode
set showcmd
set visualbell
" LazyVim syncs with the system clipboard; ideaput pastes through the IDE so
" Java imports get added on paste.
set clipboard+=unnamedplus
set clipboard+=ideaput
" which-key: wait for the rest of a mapping instead of timing out.
set notimeout
" J uses IntelliJ's smart join (merges string literals, nested ifs, ...).
set ideajoin


" ============================================================================
" Plugins
" ============================================================================

" neo-tree keys in the Project tool window (set before NERDTree loads).
" Turn off 'Open Files with Single Click' in the Project view.
let g:NERDTreeMapActivateNode = 'l'
let g:NERDTreeMapCloseDir = 'h'
let g:NERDTreeMapNewFile = 'a'
let g:NERDTreeMapNewDir = 'A'
let g:NERDTreeMapToggleZoom = 'Z'
let g:NERDTreeMapOpenSplit = 'S'

let g:highlightedyank_highlight_duration = "150"

" Vim AnyObject, arranged on LazyVim's mini.ai letters. Each letter also gets
" ]x / [x jumps, so letters LazyVim uses for ]b ]d ]e ]q must stay free.
"   af/if function   ac/ic class      aa/ia argument   ag/ig whole buffer
"   ao/io bracket ({} block in Java)  al/il loop       ay/iy conditional
"   ak/ik comment    as/is string     au/iu subword    av/iv variable
"   ai/ii list item  am/im lambda or function          an/in indent block
" Quotes come from mini-ai (aq / iq) so ]q stays quickfix.
let g:anyobject_excluded = "anyQuote"
let g:anyobject_map_anydocument = "g"
let g:anyobject_map_anystring = "s"
set anyobject

" gc{motion} / gcc
Plug 'tpope/vim-commentary'
" ys{motion}{char}, cs{old}{new}, ds{char}
Plug 'tpope/vim-surround'
Plug 'machakann/vim-highlightedyank'
" Visual * / # search for the selection, like Neovim
Plug 'bronson/vim-visual-star-search'
" Vim keys in the Project tool window
Plug 'preservim/nerdtree'
" % also jumps between if/else, XML tags, ...
packadd matchit
" mini.ai: aq / iq any quote, ab / ib any bracket
set mini-ai
" Register contents pop up on " and insert-mode <C-r> (which-key's registers)
set peekaboo
" Ctrl+Shift+\ labels buttons/tabs/tree nodes; NERDTree open keys in every
" tree; window keys inside tool windows. Needs AceJump.
set VimEverywhere
set which-key

let g:WhichKey_SortOrder = "by_key_prefix_first"
let g:WhichKey_SortCaseSensitive = "false"


" ============================================================================
" Ctrl-key ownership
" ============================================================================
" Vim gets the Ctrl keys, as in Neovim. The IntelliJ features they used to
" trigger are on leader keys below (Ctrl+E -> <leader>fr, Ctrl+K -> <leader>gs,
" Ctrl+W -> <C-Space>, ...). Shift/Alt-based IDE shortcuts (Alt+Enter,
" Alt+Insert, Shift+F6, ...) are untouched.
" In insert mode <C-n>/<C-p>/<C-y>/<C-e> drive the completion popup, as in
" blink.cmp -- IdeaVim does that natively when the keys are Vim's.

sethandler <C-a> a:vim
sethandler <C-b> a:vim
sethandler <C-c> a:vim
sethandler <C-d> a:vim
sethandler <C-e> a:vim
sethandler <C-f> a:vim
sethandler <C-h> a:vim
sethandler <C-i> a:vim
sethandler <C-j> a:vim
sethandler <C-k> a:vim
sethandler <C-l> a:vim
sethandler <C-n> a:vim
sethandler <C-o> a:vim
sethandler <C-p> a:vim
sethandler <C-r> a:vim
sethandler <C-s> a:vim
sethandler <C-u> a:vim
sethandler <C-w> a:vim
sethandler <C-x> a:vim
sethandler <C-y> a:vim
sethandler <A-j> a:vim
sethandler <A-k> a:vim
" Insert-mode exceptions: Ctrl+V pastes, Ctrl+Space completes, Ctrl+/ comments.
sethandler <C-v> n-x:vim i:ide
sethandler <C-Space> n-x:vim i:ide
sethandler <C-/> n:vim i-x:ide


" ============================================================================
" Personal tweaks (ported from ~/.config/nvim/lua/config/keymaps.lua)
" ============================================================================

" d/D/x/X/c/C delete into the black hole register unless a register is named
" explicitly ("ad, "ax). With clipboard=unnamedplus the implicit register is
" "+" (or "*" where IntelliJ has no primary selection), so all three default
" registers count as "none given". Normal and visual only: operator-pending
" is left alone so dd/cc still work. s is left to flash (use cl).
nnoremap <expr> d v:register =~# '^["*+]$' ? '"_d' : 'd'
xnoremap <expr> d v:register =~# '^["*+]$' ? '"_d' : 'd'
nnoremap <expr> D v:register =~# '^["*+]$' ? '"_D' : 'D'
xnoremap <expr> D v:register =~# '^["*+]$' ? '"_D' : 'D'
nnoremap <expr> x v:register =~# '^["*+]$' ? '"_x' : 'x'
xnoremap <expr> x v:register =~# '^["*+]$' ? '"_x' : 'x'
nnoremap <expr> X v:register =~# '^["*+]$' ? '"_X' : 'X'
xnoremap <expr> X v:register =~# '^["*+]$' ? '"_X' : 'X'
nnoremap <expr> c v:register =~# '^["*+]$' ? '"_c' : 'c'
xnoremap <expr> c v:register =~# '^["*+]$' ? '"_c' : 'c'
nnoremap <expr> C v:register =~# '^["*+]$' ? '"_C' : 'C'
xnoremap <expr> C v:register =~# '^["*+]$' ? '"_C' : 'C'

" Visual p would swap the replaced text into the register; P doesn't.
xnoremap p P

" W / B / E move by camelCase humps (IdeaVim's [w [b ]w). noremap so they
" keep the built-in motions even though [b / ]b are remapped to buffers below.
nnoremap W [w
xnoremap W [w
onoremap W [w
nnoremap B [b
xnoremap B [b
onoremap B [b
nnoremap E ]w
xnoremap E ]w
onoremap E ]w


" ============================================================================
" General keymaps (LazyVim config/keymaps.lua)
" ============================================================================

" n always searches forward, N backward, whichever of / or ? started it.
nnoremap <expr> n v:searchforward ? 'n' : 'N'
xnoremap <expr> n v:searchforward ? 'n' : 'N'
onoremap <expr> n v:searchforward ? 'n' : 'N'
nnoremap <expr> N v:searchforward ? 'N' : 'n'
xnoremap <expr> N v:searchforward ? 'N' : 'n'
onoremap <expr> N v:searchforward ? 'N' : 'n'

nnoremap <Esc> :nohlsearch<CR><Esc>
nnoremap Y y$
xnoremap < <gv
xnoremap > >gv

nmap <C-s> <Action>(SaveAll)
imap <C-s> <Esc><Action>(SaveAll)
xmap <C-s> <Esc><Action>(SaveAll)

nmap <A-j> <Action>(MoveLineDown)
imap <A-j> <Action>(MoveLineDown)
xmap <A-j> <Action>(MoveLineDown)
nmap <A-k> <Action>(MoveLineUp)
imap <A-k> <Action>(MoveLineUp)
xmap <A-k> <Action>(MoveLineUp)

" Windows (editor splits)
nnoremap <C-h> <C-w>h
nnoremap <C-j> <C-w>j
nnoremap <C-k> <C-w>k
nnoremap <C-l> <C-w>l
nmap <C-Up> <Action>(StretchSplitToTop)
nmap <C-Down> <Action>(StretchSplitToBottom)
nmap <C-Left> <Action>(StretchSplitToLeft)
nmap <C-Right> <Action>(StretchSplitToRight)

" Buffers (editor tabs)
nmap <S-h> <Action>(PreviousTab)
nmap <S-l> <Action>(NextTab)
let g:WhichKeyDesc_prev_b = "[b Prev Buffer"
nmap [b <Action>(PreviousTab)
let g:WhichKeyDesc_next_b = "]b Next Buffer"
nmap ]b <Action>(NextTab)

" Terminal (LazyVim <C-/>)
nmap <C-/> <Action>(ActivateTerminalToolWindow)

" Treesitter-style incremental selection
nmap <C-Space> <Action>(EditorSelectWord)
xmap <C-Space> <Action>(EditorSelectWord)
xmap <BS> <Action>(EditorUnSelectWord)

" Comments
let g:WhichKeyDesc_gco = "gco Add Comment Below"
nmap gco o<Action>(CommentByLineComment)
let g:WhichKeyDesc_gcO = "gcO Add Comment Above"
nmap gcO O<Action>(CommentByLineComment)

" flash.nvim (vim-flash). Normal/visual only, so d/c/y + f/t in
" operator-pending mode keep Vim's built-in motions.
nmap s <Action>(flash.search)
xmap s <Action>(flash.search)
nmap S <Action>(flash.treesitter)
xmap S <Action>(flash.treesitter)
nmap f <Action>(flash.find)
xmap f <Action>(flash.find)
nmap F <Action>(flash.find_backward)
xmap F <Action>(flash.find_backward)
nmap t <Action>(flash.till)
xmap t <Action>(flash.till)
nmap T <Action>(flash.till_backward)
xmap T <Action>(flash.till_backward)
nmap ; <Action>(flash.repeat)
xmap ; <Action>(flash.repeat)
nmap , <Action>(flash.repeat_backward)
xmap , <Action>(flash.repeat_backward)


" ============================================================================
" LSP-style navigation
" ============================================================================

let g:WhichKeyDesc_g = "g +goto"
let g:WhichKeyDesc_g_d = "gd Goto Definition"
nmap gd <Action>(GotoDeclaration)
let g:WhichKeyDesc_g_r = "gr References"
nmap gr <Action>(ShowUsages)
let g:WhichKeyDesc_g_I = "gI Goto Implementation"
nmap gI <Action>(GotoImplementation)
let g:WhichKeyDesc_g_y = "gy Goto Type Definition"
nmap gy <Action>(GotoTypeDeclaration)
let g:WhichKeyDesc_g_K = "gK Signature Help"
nmap gK <Action>(ParameterInfo)
let g:WhichKeyDesc_g_ai = "gai Call Hierarchy"
nmap gai <Action>(CallHierarchy)
nmap K <Action>(QuickJavaDoc)
imap <C-k> <Action>(ParameterInfo)

let g:WhichKeyDesc_prev = "[ +prev"
let g:WhichKeyDesc_next = "] +next"
let g:WhichKeyDesc_next_ref = "]] Next Reference"
nmap ]] <Action>(GotoNextElementUnderCaretUsage)
let g:WhichKeyDesc_prev_ref = "[[ Prev Reference"
nmap [[ <Action>(GotoPrevElementUnderCaretUsage)
let g:WhichKeyDesc_next_d = "]d Next Diagnostic"
nmap ]d <Action>(GotoNextError)
let g:WhichKeyDesc_prev_d = "[d Prev Diagnostic"
nmap [d <Action>(GotoPreviousError)
let g:WhichKeyDesc_next_e = "]e Next Error"
nmap ]e <Action>(GotoNextError)
let g:WhichKeyDesc_prev_e = "[e Prev Error"
nmap [e <Action>(GotoPreviousError)
let g:WhichKeyDesc_next_q = "]q Next Quickfix (find/usage result)"
nmap ]q <Action>(NextOccurence)
let g:WhichKeyDesc_prev_q = "[q Prev Quickfix (find/usage result)"
nmap [q <Action>(PreviousOccurence)
let g:WhichKeyDesc_next_h = "]h Next Hunk"
nmap ]h <Action>(VcsShowNextChangeMarker)
let g:WhichKeyDesc_prev_h = "[h Prev Hunk"
nmap [h <Action>(VcsShowPrevChangeMarker)
" ]f [f ]c [c ]a [a ... come from AnyObject.
let g:WhichKeyDesc_next_f = "]f Next Function Start"
let g:WhichKeyDesc_prev_f = "[f Prev Function Start"
let g:WhichKeyDesc_next_c = "]c Next Class Start"
let g:WhichKeyDesc_prev_c = "[c Prev Class Start"
let g:WhichKeyDesc_next_a = "]a Next Argument"
let g:WhichKeyDesc_prev_a = "[a Prev Argument"
let g:WhichKeyDesc_next_F = "]F Next Function End"
nnoremap ]F ]M
let g:WhichKeyDesc_prev_F = "[F Prev Function End"
nnoremap [F [M
let g:WhichKeyDesc_next_t = "]t Next Todo Comment"
nnoremap ]t /\v<(TODO<Bar>FIXME<Bar>HACK<Bar>WARN<Bar>PERF<Bar>NOTE<Bar>FIX)><CR>
let g:WhichKeyDesc_prev_t = "[t Prev Todo Comment"
nnoremap [t ?\v<(TODO<Bar>FIXME<Bar>HACK<Bar>WARN<Bar>PERF<Bar>NOTE<Bar>FIX)><CR>


